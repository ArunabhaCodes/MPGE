for(var in c("G.P", "GE.P")) {
tmp <- pvalSNP[, grep(var, colnames(pvalSNP)), drop = FALSE]
colnames(tmp) <- gsub(paste0(".", var), "", colnames(tmp))
RESULTS[ ,var] <- t(tmp[, RESULTS$SNP])
}
